# ==========================================
# Niyuvia - Root Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/
coverage.xml

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Node.js
node_modules/
.next/
.nuxt/
.output/
.turbo/
.parcel-cache/
*.tsbuildinfo

# Frontend build output
out/
storybook-static/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Database files and local data
*.sqlite
*.sqlite3
*.db
data/local/
uploads/
storage/local/

# Docker local overrides
docker-compose.override.yml

# IDE settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Environment-specific files
*.local
